# ==============================================================================
# X-NATIVE ENTERPRISE FULLSTACK CONFIGURATION (.env)
# ==============================================================================

# Aplikasi & Lingkungan
APP_NAME="X-Native Enterprise Web"
APP_ENV=dev
DEBUG=2
APP_URL="http://localhost/groblive/x-native/"

# Sesi & Keamanan Web Cookie
SESSION_LIFETIME=7200

# ==============================================================================
# FITUR MULTI-DATABASE CONNECTION POOL
# ==============================================================================

# 1. Database Utama (Default) -> Dipanggil via $this->db()
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=test
DB_USER=root
DB_PASS=

# 2. Database Logistik / Pengiriman -> Dipanggil via $this->db('logistik')
DB_LOGISTIK_HOST=127.0.0.1
DB_LOGISTIK_PORT=3306
DB_LOGISTIK_NAME=app_pengiriman
DB_LOGISTIK_USER=root
DB_LOGISTIK_PASS=

# 3. Database Reporting / Arsip -> Dipanggil via $this->db('report')
DB_REPORT_HOST=127.0.0.1
DB_REPORT_PORT=3306
DB_REPORT_NAME=sima_reporting
DB_REPORT_USER=root
DB_REPORT_PASS=
